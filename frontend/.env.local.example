# Deployed KnockKnockMailbox address on Flare Coston2.
# Replace with the address from:
#   npx hardhat run scripts/deploy.js --network coston2
NEXT_PUBLIC_MAILBOX_ADDRESS=0x0000000000000000000000000000000000000000

# Deployed KnockKnockFCCVerifier address on Flare Coston2.
# Replace with the address from:
#   npx hardhat run scripts/deployFCC.js --network coston2
NEXT_PUBLIC_FCC_VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: proxy/relayer URL that returns the TEE-signed proof for the FCC flow.
# For local development use the FCC TypeScript server, e.g. http://localhost:7702/action.
NEXT_PUBLIC_FCC_PROXY_URL=

# Optional: Firebase Functions emulator host for local verification backend.
# Format: host:port (e.g. localhost:5001). Leave empty to use production functions.
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR=

# Firebase project configuration.
# Get these values from Firebase Console → Project Settings → General → Your apps → Web app.
# Authentication must be enabled (Google provider + Email/Password).
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.region.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
