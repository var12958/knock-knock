{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false,
        ".validate": "newData.hasChildren(['uid', 'username', 'createdAt']) && newData.child('uid').val() == $uid && !newData.hasChild('isVerifiedHuman') && !newData.hasChild('isOldEnoughWallet') && !newData.hasChild('verificationTxHash') && !newData.hasChild('verifiedAt') && (!data.hasChild('walletAddress') || newData.child('walletAddress').val() == data.child('walletAddress').val())"
      }
    },
    "contacts": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "deletedChats": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "groups": {
      "$uid": {
        "$groupId": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['requestIds','createdAt']) && newData.child('createdAt').isNumber() && newData.child('requestIds').hasChildren()"
        }
      }
    },
    "usernames": {
      "$username": {
        ".read": true,
        ".write": false,
        ".validate": "newData.hasChildren(['uid', 'reservedAt']) && $username.length > 0"
      }
    },
    "walletAddresses": {
      "$address": {
        ".read": false,
        ".write": false,
        ".validate": "newData.hasChildren(['uid', 'linkedAt'])"
      }
    },
    "twitterByWallet": {
      "$address": {
        ".read": true,
        ".write": false,
        ".validate": "newData.hasChildren(['twitterVerified','twitterHandle','verifiedBy','verifiedAt']) && newData.child('twitterVerified').isBoolean() && newData.child('verifiedAt').isNumber()"
      }
    },
    "requests": {
      "$requestId": {
        ".read": "auth != null && (auth.uid == data.child('senderUid').val() || auth.uid == data.child('receiverUid').val())",
        ".write": false,
        ".validate": "newData.hasChildren(['senderUid', 'receiverUid', 'senderAddress', 'receiverAddress', 'createdAt'])"
      }
    },
    "chats": {
      "$requestId": {
        ".read": true,
        ".write": true,
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['sender', 'text', 'timestamp'])"
          }
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
