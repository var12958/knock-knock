# Human Passport (formerly Gitcoin Passport) API credentials.
# Copy this file to .env and fill in your real values.
PASSPORT_API_KEY=<INSERT_YOUR_API_KEY_HERE>
PASSPORT_SCORER_ID=12119

# Optional: override the default Human Passport scorer endpoint.
# PASSPORT_API_URL=https://api.scorer.gitcoin.co/registry/score

# Optional: legacy identity API fallback (real API only).
# IDENTITY_API_URL=

# Flare RPC endpoint for Proof-of-History.
# FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# TEE signer private key (hex, no 0x prefix).
# TEE_SIGNER_PRIVATE_KEY=

# Local development port for the standalone HTTP server.
# EXTENSION_PORT=7702

# --- ML behavioral Sybil detection tuning ---
# Maximum blocks to scan for outgoing transactions.
# ML_SCAN_MAX_BLOCKS=5000
# Hard timeout (ms) for the on-chain analysis pass.
# ML_SCAN_TIMEOUT_MS=30000
# Concurrency for block scanning, receipt fetching, and code fetching.
# ML_SCAN_CONCURRENCY=20
# ML_RECEIPT_FETCH_CONCURRENCY=10
# ML_CODE_FETCH_CONCURRENCY=10

# --- Twitter verification via the Flare Data Connector (FDC) ---
# Base URL of the FDC verifier. On Coston2: https://coston2-verifier.flare.network
# Leave empty to use the deterministic mock (hackathon default).
# FDC_VERIFIER_URL=https://coston2-verifier.flare.network
# Twitter API v2 bearer token used inside the FDC Web2Json attestation.
# TWITTER_BEARER_TOKEN=
# Optional: override the Twitter API base (e.g. a mock endpoint).
# TWITTER_API_BASE_URL=https://api.twitter.com/2
# Force the mock verifier even when FDC_VERIFIER_URL is set.
# FDC_MOCK_TWITTER=false
# FDC_POLL_INTERVAL_MS=3000
# FDC_POLL_MAX_ATTEMPTS=40
